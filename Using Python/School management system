class Student:
    def __init__(self,name,new_class,id):
        self.name=name
        self.id=id
        self.new_class=new_class

    def __repr__(self):
        return f"Student name: {self.name}\nClass: {self.new_class}\nId: {self.id}"
    

class Teacher:
    def __init__(self,name,subjec,id):
        self.name=name
        self.subject=subjec
        self.id=id

    def __repr__(self):
        return f"Teacher name: {self.name}\nId: {self.id}\nAssigned subject: {self.subject}"
    

class School:
    def __init__(self,Sname):
        self.Sname=Sname
        self.teachers=[]
        self.students=[]

    def add_teacher(self,name,subject):
        id=len(self.teachers)+101
        teacher=Teacher(name,subject,id)
        self.teachers.append(teacher)

    def enroll(self,name,fee):
        if fee<6500:
            return "not enough fee!"
        else:
            id=len(self.students)+1
            student =Student(name,"C",id)
            self.students.append(student)

            return f"{name} is enrolled with id: {id}, due: -{fee-6500}"
        
    def __str__(self):
        print("Welcome to", self.Sname)
        print("..........OUR TEACHERS.........")
        for teacher in self.teachers:
            print(teacher)
        print("..........OUR STUEDENTS.........")
        for student in self.students:
            print(student)

        return "Successfull execution."
    

daffodil = School("Daffodil School")

#adding students
daffodil.enroll("Alia",5200)
daffodil.enroll("Katrina",8000)
daffodil.enroll("Tamanna",20000)

#adding teachers
daffodil.add_teacher("Tom","DSA")
daffodil.add_teacher("Mr. Jerry","System Analysis")

print(daffodil)
